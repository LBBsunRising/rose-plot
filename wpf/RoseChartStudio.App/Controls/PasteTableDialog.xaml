<Window x:Class="RoseChartStudio.App.Controls.PasteTableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="粘贴表格数据" Width="980" Height="760"
        MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBg}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        FontSize="13" Foreground="{DynamicResource Text}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="粘贴表格数据" FontSize="22" FontWeight="Medium" />
            <TextBlock Text="从 Excel、Google Sheets 或网页复制表格，直接粘贴到下方；支持 Tab、CSV、分号和竖线分隔。"
                       Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,10">
            <CheckBox x:Name="HeaderCheck" Content="首行作为表头" IsChecked="True"
                      Checked="HeaderCheck_Changed" Unchecked="HeaderCheck_Changed"
                      VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="从剪贴板读取"
                        Click="ReadClipboard_Click" Height="36" MinHeight="36" Padding="16,0" />
            </StackPanel>
        </Grid>

        <TextBox x:Name="SourceBox" Grid.Row="2" Height="190"
                 AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12.5"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top"
                 materialDesign:HintAssist.Hint="在此粘贴表格内容（Ctrl+V）"
                 TextChanged="SourceBox_TextChanged" />

        <Grid Grid.Row="3" Margin="0,16,0,6">
            <TextBlock Text="预览" Style="{StaticResource SectionTitle}" Margin="0" />
            <TextBlock x:Name="ParseSummary" Text="等待粘贴数据" FontSize="12"
                       Foreground="{StaticResource Muted}" HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="4" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                CornerRadius="10" ClipToBounds="True" Padding="6">
            <Grid>
                <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" RowHeight="32" ColumnHeaderHeight="38"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserResizeRows="False" CanUserSortColumns="False"
                          CanUserReorderColumns="False" SelectionMode="Single"
                          SelectionUnit="Cell" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource Hairline}"
                          Background="Transparent" BorderThickness="0" FontSize="12"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                    <DataGrid.CellStyle>
                        <Style TargetType="{x:Type DataGridCell}">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </DataGrid.CellStyle>
                </DataGrid>
                <TextBlock x:Name="ParseHint" Text="粘贴后会自动检测列和行"
                           Style="{StaticResource CaptionText}" Margin="12,16"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Row="5" Margin="0,16,0,0">
            <TextBlock x:Name="ParseStatus" Text="请粘贴表格内容" Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="620" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="取消"
                        IsCancel="True" Height="40" MinHeight="40" Padding="24,0" Margin="0,0,10,0" />
                <Button x:Name="GenerateButton" Style="{StaticResource PrimaryButton}"
                        Content="生成图表" IsDefault="True" IsEnabled="False"
                        Click="Generate_Click" Height="40" MinHeight="40" Padding="28,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
