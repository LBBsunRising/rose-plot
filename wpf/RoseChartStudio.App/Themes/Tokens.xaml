<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Simple-line (paper + ink) color roles -->
    <Color x:Key="PrimaryColor">#1F1F1C</Color>
    <Color x:Key="OnPrimaryColor">#FFFDF7</Color>
    <Color x:Key="PrimaryContainerColor">#E9E2D4</Color>
    <Color x:Key="OnPrimaryContainerColor">#1F1F1C</Color>
    <Color x:Key="SecondaryColor">#55534B</Color>
    <Color x:Key="SecondaryContainerColor">#E4DED0</Color>
    <Color x:Key="AppBgColor">#F6F2E8</Color>
    <Color x:Key="SurfaceColor">#FFFDF7</Color>
    <Color x:Key="SurfaceContainerLowColor">#F7F3E9</Color>
    <Color x:Key="SurfaceContainerColor">#EFE9DC</Color>
    <Color x:Key="SurfaceContainerHighColor">#E4DCCB</Color>
    <Color x:Key="TextColor">#1E1E1B</Color>
    <Color x:Key="MutedColor">#67645B</Color>
    <Color x:Key="OutlineColor">#2B2A26</Color>
    <Color x:Key="OutlineVariantColor">#BDB6A7</Color>
    <Color x:Key="PrimaryDarkColor">#141412</Color>
    <Color x:Key="PrimarySoftColor">#F0E9DB</Color>
    <Color x:Key="SuccessColor">#4A7353</Color>
    <Color x:Key="WarningColor">#9A6A2E</Color>
    <Color x:Key="ErrorColor">#A84131</Color>
    <Color x:Key="PreviewBgColor">#FAF6EB</Color>
    <Color x:Key="SelectedSoftColor">#EDE5D6</Color>
    <Color x:Key="TrackColor">#C9C1B1</Color>

    <SolidColorBrush x:Key="AppBg" Color="{StaticResource AppBgColor}" />
    <SolidColorBrush x:Key="Panel" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="PanelSoft" Color="{StaticResource SurfaceContainerLowColor}" />
    <SolidColorBrush x:Key="SurfaceContainer" Color="{StaticResource SurfaceContainerColor}" />
    <SolidColorBrush x:Key="SurfaceContainerHigh" Color="{StaticResource SurfaceContainerHighColor}" />
    <SolidColorBrush x:Key="Hairline" Color="{StaticResource OutlineVariantColor}" />
    <SolidColorBrush x:Key="Outline" Color="{StaticResource OutlineColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="Primary" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="OnPrimary" Color="{StaticResource OnPrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryContainer" Color="{StaticResource PrimaryContainerColor}" />
    <SolidColorBrush x:Key="PrimaryDark" Color="{StaticResource PrimaryDarkColor}" />
    <SolidColorBrush x:Key="PrimarySoft" Color="{StaticResource PrimarySoftColor}" />
    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="Error" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="PreviewBg" Color="{StaticResource PreviewBgColor}" />
    <SolidColorBrush x:Key="SelectedSoft" Color="{StaticResource SelectedSoftColor}" />
    <SolidColorBrush x:Key="Track" Color="{StaticResource TrackColor}" />

    <!-- Sketch UI roles -->
    <SolidColorBrush x:Key="Ink" Color="#1E1E1B" />
    <SolidColorBrush x:Key="InkSoft" Color="#4A4841" />
    <SolidColorBrush x:Key="Paper" Color="#FFFDF7" />
    <SolidColorBrush x:Key="PaperWarm" Color="#F8F3E7" />
    <SolidColorBrush x:Key="Graphite" Color="#6A675E" />
    <SolidColorBrush x:Key="Rule" Color="#C9C1B1" />
    <SolidColorBrush x:Key="Accent" Color="#B54A32" />
    <SolidColorBrush x:Key="AccentSoft" Color="#F2DDD5" />
    <SolidColorBrush x:Key="Sticky" Color="#FBF2D8" />
    <SolidColorBrush x:Key="StickyLine" Color="#CBBF9A" />

    <!-- Handwriting / display -->
    <FontFamily x:Key="UiFont">Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="SketchFont">KaiTi</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe Print</FontFamily>
    <FontFamily x:Key="MonoSketchFont">Consolas</FontFamily>

    <sys:Double x:Key="FontBody">14</sys:Double>
    <sys:Double x:Key="FontSmall">13</sys:Double>
    <sys:Double x:Key="FontCaption">12</sys:Double>
    <sys:Double x:Key="FontSection">17</sys:Double>
    <sys:Double x:Key="FontHeader">22</sys:Double>

    <!-- Warm dot-paper backdrop. -->
    <DrawingBrush x:Key="AppBackdropBrush" TileMode="Tile"
                  Viewport="0,0,28,28" ViewportUnits="Absolute"
                  Viewbox="0,0,28,28" ViewboxUnits="Absolute"
                  Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#F6F2E8">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,28,28" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#DED6C6">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="5,5" RadiusX="0.9" RadiusY="0.9" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Light paper bars; names kept for the existing XAML hooks. -->
    <LinearGradientBrush x:Key="AppBarGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFDF7" Offset="0" />
        <GradientStop Color="#F8F3E7" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RailGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FBF7ED" Offset="0" />
        <GradientStop Color="#F3EDE0" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2A2A26" Offset="0" />
        <GradientStop Color="#101010" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AppBarText" Color="#1E1E1B" />
    <SolidColorBrush x:Key="AppBarMuted" Color="#67645B" />
    <SolidColorBrush x:Key="AppBarBorder" Color="#BDB6A7" />
    <SolidColorBrush x:Key="AppBarSurface" Color="#F1EADC" />
    <SolidColorBrush x:Key="RailIcon" Color="#34322C" />
    <SolidColorBrush x:Key="RailHover" Color="#E8E1D2" />
    <SolidColorBrush x:Key="RailActive" Color="#DED4BE" />
    <SolidColorBrush x:Key="CanvasTint" Color="#FAF6EB" />

    <!-- Chart transparency checkerboard, warmed to paper. -->
    <DrawingBrush x:Key="CheckerboardBrush" TileMode="Tile"
                  Viewport="0,0,75,72.72" ViewportUnits="Absolute"
                  Viewbox="0,0,75,72.72" ViewboxUnits="Absolute"
                  Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFFDF7">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,75,72.72" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#F7F1E3">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="37.5,0,37.5,36.36" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#F7F1E3">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,36.36,37.5,36.36" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="CheckerboardBrushSmall" TileMode="Tile"
                  Viewport="0,0,32,30" ViewportUnits="Absolute"
                  Viewbox="0,0,32,30" ViewboxUnits="Absolute"
                  Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFFDF7">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,32,30" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#F7F1E3">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="16,0,16,15" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#F7F1E3">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,15,16,15" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Dotted rule for sketch section separators. -->
    <DrawingBrush x:Key="DottedRuleBrush" TileMode="Tile"
                  Viewport="0,0,8,2" ViewportUnits="Absolute"
                  Viewbox="0,0,8,2" ViewboxUnits="Absolute" Stretch="Fill">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#8D8779">
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,3,1" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
